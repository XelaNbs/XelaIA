# ===== Cerveau =====
# claude = fluide et intelligent, avec recherche web (par défaut) | ollama = gratuit et local
JARVIS_MOTEUR=claude
# Clé API (différente de l'abonnement Claude.ai) : https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
JARVIS_MODELE=claude-sonnet-5-5
JARVIS_EFFORT=low                  # réflexion en conversation : low (rapide) | medium | high

# ===== Voix =====
# ElevenLabs (https://elevenlabs.io) : clé dans Profil > API Keys,
# puis lance « python jarvis.py --voix » pour lister tes voix et copier un ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODELE=eleven_multilingual_v2   # ou eleven_flash_v2_5 (plus rapide, moins cher)
# Voix gratuite de secours (edge-tts)
JARVIS_VOIX=fr-FR-HenriNeural

# ===== Routine du matin =====
JARVIS_ROUTINE_OFFRES=5             # dossiers préparés chaque matin

# ===== Optionnel : mode gratuit local =====
# JARVIS_MOTEUR=ollama
# JARVIS_MODELE_LOCAL=qwen3:8b
