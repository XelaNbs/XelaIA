# ===== Cerveau =====
# ollama = gratuit, local, hors ligne (par défaut) | claude = payant, plus intelligent
JARVIS_MOTEUR=ollama
JARVIS_MODELE_LOCAL=qwen3:8b

# Seulement si JARVIS_MOTEUR=claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-...
# JARVIS_MODELE=claude-sonnet-5-5   # ou claude-haiku-5-5 (environ 20 fois moins cher)
# JARVIS_EFFORT=low

# ===== Voix =====
# JARVIS_VOIX=fr-FR-HenriNeural     # ou fr-FR-DeniseNeural

# ===== Agent emploi (gratuit) =====
